{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "functions": {
    "api/mesh/[date].ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/spc/check-date.ts": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/diagnostics.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "env": {
    "NODE_VERSION": "20"
  }
}
